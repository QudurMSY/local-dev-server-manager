{
  "name": "local-dev-server-manager",
  "productName": "Local Dev Server Manager",
  "version": "1.0.0",
  "description": "Lightweight Linux dev server manager for web projects",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "start": "vite build && electron .",
    "dev:react": "vite",
    "dev:electron": "electron . --dev",
    "dev": "concurrently -k \"npm run dev:react\" \"wait-on http://localhost:5173 && npm run dev:electron\"",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "ansi-to-html": "^0.7.2",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^43.2.0",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  }
}
